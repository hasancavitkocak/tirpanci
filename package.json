{
  "name": "kral-tirpan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kral Tırpan Simülatörü - 3D mobil ot biçme oyunu (Three.js + Capacitor)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host",
    "dev:low": "node scripts/dev-low.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "android:debug": "npm run cap:sync && node scripts/android-build.mjs debug"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/native-purchases": "^8.9.6",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@types/three": "^0.186.0",
    "puppeteer-core": "^25.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
